{
  "opencollection": "1.0.0",
  "info": {
    "name": "Revert Unified Chat Proxy API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-revert-api-token",
      "value": "{{x-revert-api-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Proxy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "CRM passthrough proxy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.revert.dev/crm/proxy",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Forward a request to the underlying CRM provider's native API using the linked connection."
        },
        {
          "info": {
            "name": "Ticketing passthrough proxy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.revert.dev/ticket/proxy",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Ticketing passthrough proxy"
        }
      ]
    }
  ],
  "bundled": true
}